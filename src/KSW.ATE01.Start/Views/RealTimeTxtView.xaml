<UserControl x:Class="KSW.ATE01.Start.Views.RealTimeTxtView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KSW.ATE01.Start.Views"
        xmlns:language="clr-namespace:KSW.ATE01.Start"
        xmlns:converter="clr-namespace:KSW.ATE01.Start.Converter"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        prism:ViewModelLocator.AutoWireViewModel="True">

    <!--<prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="ThreeDBorderWindow"></Setter>
            <Setter Property="Height" Value="450"></Setter>
            <Setter Property="Width" Value="800"></Setter>
            <Setter Property="ResizeMode" Value="CanResize"></Setter>
            <Setter Property="ShowInTaskbar" Value="False"></Setter>
        </Style>
    </prism:Dialog.WindowStyle>-->

    <UserControl.Resources>
        <converter:StringConcatenateConverter x:Key="StringConcatenateConverter"></converter:StringConcatenateConverter>
    </UserControl.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Unloaded">
            <i:InvokeCommandAction Command="{Binding LoadingCommand}" CommandParameter="{Binding ElementName=richTB}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="5"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TextBlock Margin="8" Text="{language:L FindTarget,Converter={StaticResource StringConcatenateConverter},ConverterParameter=(F)}" VerticalAlignment="Center" Foreground="Black"></TextBlock>
                <TextBox Grid.Column="1" Padding="4,0,0,0" Text="{Binding SearchContent,UpdateSourceTrigger=LostFocus}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="Black"></TextBox>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <CheckBox Margin="0,0,8,0" Content="{language:L WholeWordMatch}" IsChecked="{Binding IsWholeWordMatch}" Foreground="Black"></CheckBox>
                <CheckBox Margin="0,0,8,0" Grid.Column="1" Content="{language:L LoopSearch}" IsChecked="{Binding IsLoopSearch}" Foreground="Black"></CheckBox>
                <Button Margin="0,0,8,0" Grid.Column="3" Content="{language:L SearchUp}" Command="{Binding SearchCommand}" CommandParameter="True" Style="{StaticResource MaterialDesignFlatButton}"></Button>
                <Button Grid.Column="4" Content="{language:L SearchDown}" Command="{Binding SearchCommand}" CommandParameter="False" Style="{StaticResource MaterialDesignFlatButton}"></Button>
            </Grid>
        </Grid>

        <RichTextBox Grid.Row="1" x:Name="richTB" Margin="4" Padding="4" IsReadOnly="True" ScrollViewer.VerticalScrollBarVisibility="Auto" Style="{StaticResource MaterialDesignOutlinedRichTextBox}">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="Loaded">
                    <i:InvokeCommandAction Command="{Binding LoadingCommand}" CommandParameter="{Binding ElementName=richTB}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <RichTextBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{language:L Copy}" Command="ApplicationCommands.Copy"></MenuItem>
                    <MenuItem Header="{language:L ClearAll}" InputGestureText="Ctrl+D" Command="{Binding ClearAllCommand}"></MenuItem>
                    <MenuItem Header="{language:L GotoPreviousHighlight}" Command="{Binding GoToHighlightCommand}" CommandParameter="False" InputGestureText="Alt+Up"></MenuItem>
                    <MenuItem Header="{language:L GotoNextHighlight}"  Command="{Binding GoToHighlightCommand}" CommandParameter="True" InputGestureText="Alt+Down"></MenuItem>
                    <MenuItem Header="{language:L PauseWindow}" Command="{Binding PauseCommand}" IsCheckable="True" IsChecked="{Binding IsPauseWindow}"></MenuItem>
                    <Separator></Separator>
                    <MenuItem Header="{language:L ViewOptions,Converter={StaticResource StringConcatenateConverter},ConverterParameter=...}" Command="{Binding ViewOptionsCommand}"></MenuItem>
                    <Separator></Separator>
                    <MenuItem Header="{language:L ReopenFile}" Command="{Binding ReopenFileCommand}" InputGestureText="Ctrl+R"></MenuItem>
                    <Separator></Separator>
                    <MenuItem Header="{language:L Bookmarks}">
                        <MenuItem Header="{language:L ToggleBookmark}" Command="{Binding ToggleBookmarkCommand}"></MenuItem>
                        <MenuItem Header="{language:L NextBookmark}" Command="{Binding GoToBookmarkCommand}" CommandParameter="True"></MenuItem>
                        <MenuItem Header="{language:L PreviousBookmark}" Command="{Binding GoToBookmarkCommand}"  CommandParameter="False"></MenuItem>
                        <MenuItem Header="{language:L ClearBookmarks}" Command="{Binding ClearBookmarkCommand}"></MenuItem>
                    </MenuItem>
                </ContextMenu>
            </RichTextBox.ContextMenu>
        </RichTextBox>
    </Grid>
</UserControl>
