<UserControl x:Class="KSW.ATE01.Start.Views.Dialogs.RunDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KSW.ATE01.Start.Views.Dialogs"
             xmlns:language="clr-namespace:KSW.ATE01.Start"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:viewmodel="clr-namespace:KSW.ATE01.Start.ViewModels.Dialogs"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance viewmodel:RunDialogViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="ThreeDBorderWindow"></Setter>
            <Setter Property="Height" Value="870"></Setter>
            <Setter Property="Width" Value="1200"></Setter>
            <Setter Property="ShowInTaskbar" Value="False"></Setter>
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.Resources>
        <Style x:Key="BrowseTextBlock" TargetType="{x:Type TextBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border BorderThickness="1" BorderBrush="Black" CornerRadius="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="auto"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <TextBlock Padding="6,0,0,0" Text="{Binding Path=Text, RelativeSource={RelativeSource AncestorType=TextBox}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"></TextBlock>
                                <Button Padding="6" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedButton}" BorderThickness="0" ToolTip="{language:L Browse}" Command="{Binding DataContext.OpenFolderCommand,RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}}">
                                    <Button.Content>
                                        <materialDesign:PackIcon Kind="FolderOpenOutline" />
                                    </Button.Content>
                                </Button>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CenterTextBlock"  TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
        </Style>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
        </Style>
    </UserControl.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadingCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="leftColumn" Width="*" MinWidth="100"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition x:Name="rightColumn" Width="Auto" ></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <FrameworkElement x:Name="DataContextProxy" DataContext="{Binding}" />
        <Border HorizontalAlignment="Stretch" Margin="0,0,6,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <GroupBox Margin="0,0,0,6" Header="{language:L Datalog}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <CheckBox Margin="0,0,0,6" Content="RealTime TXT" IsChecked="{Binding ProjectInfo.SaveRealTimeText}"></CheckBox>
                        <CheckBox Margin="0,0,0,6" Grid.Column="1" Content="CSV" IsChecked="{Binding ProjectInfo.SaveCsv}"></CheckBox>
                        <CheckBox Margin="0,0,0,6" Grid.Column="2"  Content="Summary" IsChecked="{Binding ProjectInfo.SaveSummary}"></CheckBox>
                        <CheckBox Margin="0,0,0,6" Grid.Column="3"  Content="STDF" IsChecked="{Binding ProjectInfo.SaveStdf}"></CheckBox>

                        <Grid Grid.Row="1" Grid.ColumnSpan="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label VerticalAlignment="Center" Content="{language:L LogPath}"></Label>
                            <TextBox Margin="0,0,0,6" Grid.Column="1" IsReadOnly="True" Style="{StaticResource BrowseTextBlock}" Text="{Binding ProjectInfo.DatalogPath}"></TextBox>
                        </Grid>
                    </Grid>
                </GroupBox>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.5*"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="auto"></RowDefinition>
                    </Grid.RowDefinitions>

                    <GroupBox Padding="0" Grid.RowSpan="4" Margin="0,0,6,0" Header="{language:L TestItem}">
                        <DataGrid  
                            materialDesign:DataGridAssist.CellPadding="4" 
                            materialDesign:DataGridAssist.ColumnHeaderPadding="4"  
                            AutoGenerateColumns="False" 
                            CanUserAddRows="False" 
                            HeadersVisibility="All" 
                            VerticalScrollBarVisibility="Auto" 
                            SelectionUnit="FullRow" 
                            SelectionMode="Single" 
                            CanUserSortColumns="False" 
                            ItemsSource="{Binding TestItemList}" 
                            CanUserResizeRows="False">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn  Binding="{Binding Enable, UpdateSourceTrigger=PropertyChanged}" CanUserReorder="False" Width="auto">
                                    <DataGridCheckBoxColumn.Header>
                                        <Border
          Background="Transparent">
                                            <CheckBox
            IsChecked="{Binding DataContext.IsAllItemsSelected, Source={x:Reference DataContextProxy}}" HorizontalAlignment="Center" VerticalContentAlignment="Center"/>
                                        </Border>
                                    </DataGridCheckBoxColumn.Header>
                                    <DataGridCheckBoxColumn.HeaderStyle>
                                        <Style
                                    TargetType="{x:Type DataGridColumnHeader}"
                                    BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                            <Setter
                                    Property="HorizontalContentAlignment"
                                    Value="Center" />
                                        </Style>
                                    </DataGridCheckBoxColumn.HeaderStyle>
                                </DataGridCheckBoxColumn>
                                <DataGridTextColumn Header="{language:L TestItem}" CanUserReorder="False" Binding="{Binding TestItemName}" IsReadOnly="True" ToolTipService.ToolTip="{Binding TestItemName}" ElementStyle="{StaticResource CenterTextBlock}">
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="{language:L Operate}" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto"></ColumnDefinition>
                                                    <ColumnDefinition Width="auto"></ColumnDefinition>
                                                </Grid.ColumnDefinitions>

                                                <Button Content="{materialDesign:PackIcon Kind=ArrowUp}" Command="{Binding ArrowUpCommand}" CommandParameter="{Binding }" ToolTip="{language:L MoveUp}" Style="{StaticResource MaterialDesignFlatButton}"></Button>

                                                <Button Grid.Column="1" Content="{materialDesign:PackIcon Kind=ArrowDown}" Command="{Binding ArrowDownCommand}"  CommandParameter="{Binding }" ToolTip="{language:L MoveDown}" Style="{StaticResource MaterialDesignFlatButton}"></Button>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Margin="0,0,0,6" Grid.Column="1" Header="{language:L Option}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <CheckBox Content="DoAll" IsChecked="{Binding ProjectInfo.IsDoAll}"></CheckBox>
                            <CheckBox Grid.Column="1" Content="{language:L PrintTime}" IsChecked="{Binding ProjectInfo.IsPrintTime}"></CheckBox>
                        </Grid>
                    </GroupBox>

                    <GroupBox Margin="0,0,0,6" Padding="0"  Grid.Column="1" Grid.Row="1" Header="{language:L SiteInformation}">
                        <DataGrid  
                            materialDesign:DataGridAssist.CellPadding="4" 
                            materialDesign:DataGridAssist.ColumnHeaderPadding="4"  
                            AutoGenerateColumns="False" 
                            CanUserAddRows="False" 
                            HeadersVisibility="All" 
                            VerticalScrollBarVisibility="Auto" 
                            SelectionUnit="FullRow" 
                            SelectionMode="Single" 
                            CanUserSortColumns="False" 
                            ItemsSource="{Binding SiteList}" 
                            CanUserResizeRows="False">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn  Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" CanUserReorder="False" Width="auto">
                                    <DataGridCheckBoxColumn.Header>
                                        <Border
Background="Transparent">
                                            <CheckBox
  IsChecked="{Binding DataContext.IsAllSitesSelected, Source={x:Reference DataContextProxy}}" HorizontalAlignment="Center" VerticalContentAlignment="Center"/>
                                        </Border>
                                    </DataGridCheckBoxColumn.Header>
                                    <DataGridCheckBoxColumn.HeaderStyle>
                                        <Style
                          TargetType="{x:Type DataGridColumnHeader}"
                          BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                            <Setter
                          Property="HorizontalContentAlignment"
                          Value="Center" />
                                        </Style>
                                    </DataGridCheckBoxColumn.HeaderStyle>
                                </DataGridCheckBoxColumn>
                                <DataGridTextColumn Width="*" Header="{language:L Site}" CanUserReorder="False" Binding="{Binding SiteName}" IsReadOnly="True" ToolTipService.ToolTip="{Binding SiteName}" ElementStyle="{StaticResource CenterTextBlock}">
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Margin="0,0,0,6" Grid.Column="1" Grid.Row="2" Header="{language:L Looping}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"></RowDefinition>
                                <RowDefinition Height="auto"></RowDefinition>
                                <RowDefinition Height="auto"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="auto"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="auto"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Margin="0,0,6,6" VerticalAlignment="Center" Content="{language:L LoopCount}"></Label>
                            <TextBox Padding="6" Margin="0,0,6,6" Grid.Column="1" BorderThickness="1" Text="{Binding ProjectInfo.LoopCount,UpdateSourceTrigger=LostFocus,Mode=TwoWay}" Style="{StaticResource MaterialDesignOutlinedTextBox}" IsEnabled="{Binding LoopCountEnabled}"></TextBox>

                            <Label Grid.Column="2" Margin="0,0,6,6" VerticalAlignment="Center" Content="{language:L LoopsExecuted}"></Label>
                            <TextBox Padding="6" Margin="0,0,6,6" Grid.Column="3" IsReadOnly="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding ProjectInfo.LoopExecuted}"></TextBox>

                            <Label Grid.Row="1" Margin="0,0,6,6" VerticalAlignment="Center" Content="{language:L DelayBetweenLoops}"></Label>
                            <TextBox Padding="6" Grid.Row="1" Margin="0,0,6,6" Grid.Column="1" Text="{Binding ProjectInfo.DelayBetweenLoops,UpdateSourceTrigger=LostFocus,Mode=TwoWay}" Style="{StaticResource MaterialDesignOutlinedTextBox}"  IsEnabled="{Binding LoopDelayEnabled}"></TextBox>

                            <Label Grid.Row="1" Grid.Column="2" Margin="0,0,6,6" VerticalAlignment="Center" Content="{language:L FailCount}"></Label>
                            <TextBox Padding="6" Grid.Row="1" Margin="0,0,6,6" Grid.Column="3" Style="{StaticResource MaterialDesignOutlinedTextBox}" IsReadOnly="True" Text="{Binding ProjectInfo.FailCount}"></TextBox>

                            <Label Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,6" Content="s（max 300s）"></Label>

                            <CheckBox Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,0,0,6" VerticalContentAlignment="Center" Content="{language:L StopOnFail}" IsChecked="{Binding ProjectInfo.StopOnFail}"></CheckBox>

                            <Button Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,6,0" Style="{StaticResource MaterialDesignOutlinedButton}" Content="{language:L Looping}" Command="{Binding LoopingCommand}"></Button>

                            <Button Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource MaterialDesignOutlinedButton}" Content="{language:L Stop}" Command="{Binding StopCommand}"></Button>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Grid.Row="3" Header="{language:L Operate}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <Button Margin="0,0,6,0"  Style="{StaticResource MaterialDesignOutlinedButton}" Content="{language:L SaveConfigure}" Command="{Binding SetTestItemCommand}"></Button>

                            <Button Margin="0,0,6,0" Grid.Column="1" Content="{language:L StartTest}" Command="{Binding StartTestCommand}"></Button>

                            <Button Grid.Column="2" Style="{StaticResource MaterialDesignOutlinedButton}" Content="{language:L EndTest}" Command="{Binding EndTestCommand}"></Button>
                        </Grid>
                    </GroupBox>
                </Grid>
            </Grid>
        </Border>

        <Expander x:Name="mainExpander" Grid.Column="2" ExpandDirection="Left" Padding="0"  materialDesign:ExpanderAssist.HeaderBackground="#0074B0" Foreground="White" HorizontalAlignment="Right" Collapsed="mainExpander_Collapsed" Expanded="mainExpander_Expanded" IsExpanded="True">
            <Expander.Header>
                <TextBlock Width="15" RenderTransformOrigin=".5,.5"
        Text="{language:L RealTimeTxt}" TextWrapping="Wrap" Foreground="White">
                </TextBlock>
            </Expander.Header>
            <ContentControl HorizontalAlignment="Stretch" Content="{Binding RealTimeTxtView}"></ContentControl>
        </Expander>

        <!-- 分割条（仅在展开时显示） -->
        <GridSplitter x:Name="gridSplitter"
                      Grid.Column="1"
                      Width="8"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Stretch"
                      Background="Gray"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      Visibility="{Binding IsExpanded,ElementName=mainExpander,Converter={StaticResource BooleanToVisibilityConverter}}"
                      >
        </GridSplitter>

    </Grid>
</UserControl>
