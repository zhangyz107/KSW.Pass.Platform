<UserControl x:Class="KSW.ATE01.Start.Views.Dialogs.FindDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KSW.ATE01.Start.Views.Dialogs"
        xmlns:language="clr-namespace:KSW.ATE01.Start"
        xmlns:converter="clr-namespace:KSW.ATE01.Start.Converter"
        xmlns:prism="http://prismlibrary.com/"
        mc:Ignorable="d">

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="ToolWindow"></Setter>
            <Setter Property="Width" Value="550"></Setter>
            <Setter Property="Height" Value="120"></Setter>
            <Setter Property="ResizeMode" Value="NoResize"></Setter>
            <Setter Property="ShowInTaskbar" Value="False"></Setter>
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.Resources>
        <converter:StringConcatenateConverter x:Key="StringConcatenateConverter"></converter:StringConcatenateConverter>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="5"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Margin="8" Text="{language:L FindTarget,Converter={StaticResource StringConcatenateConverter},ConverterParameter=(F)}" VerticalAlignment="Center"></TextBlock>
            <TextBox Grid.Column="1" Padding="0" Text="{Binding SearchContent,UpdateSourceTrigger=LostFocus}" Style="{StaticResource MaterialDesignOutlinedTextBox}"></TextBox>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <CheckBox Margin="0,0,8,0" Content="{language:L WholeWordMatch}" IsChecked="{Binding IsWholeWordMatch}"></CheckBox>
            <CheckBox Margin="0,0,8,0" Grid.Column="1" Content="{language:L LoopSearch}" IsChecked="{Binding IsLoopSearch}"></CheckBox>
            <Button Margin="0,0,8,0" Grid.Column="3" Content="{language:L SearchUp}" Command="{Binding SearchCommand}" CommandParameter="True" Style="{StaticResource MaterialDesignFlatButton}"></Button>
            <Button Margin="0,0,8,0" Grid.Column="4" Content="{language:L SearchDown}" Command="{Binding SearchCommand}" CommandParameter="False" Style="{StaticResource MaterialDesignFlatButton}"></Button>
            <Button Grid.Column="5" Content="{language:L Cancel}"  Style="{StaticResource MaterialDesignFlatButton}"></Button>
        </Grid>
    </Grid>
</UserControl>
