<UserControl x:Class="KSW.ATE01.Start.Views.Dialogs.TestPlans.AddTestItemDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KSW.ATE01.Start.Views.Dialogs.TestPlans"
             xmlns:language="clr-namespace:KSW.ATE01.Start"
             xmlns:i ="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodel="clr-namespace:KSW.ATE01.Start.ViewModels.Dialogs.TestPlans"
             xmlns:prism="http://prismlibrary.com/"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance viewmodel:AddTestItemDialogViewModel}"
             d:Background="White"
             d:DesignHeight="450" d:DesignWidth="800">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadingCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="ToolWindow"></Setter>
            <Setter Property="Height" Value="600"></Setter>
            <Setter Property="Width" Value="300"></Setter>
            <Setter Property="ResizeMode" Value="NoResize"></Setter>
            <Setter Property="ShowInTaskbar" Value="False"></Setter>
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Padding" Value="4"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Padding" Value="4"></Setter>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Visibility" Value="Collapsed"></Setter>
        </Style>
        <Style x:Key="CellTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
        </Style>
        <Style x:Key="CellEditTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}">
            <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--<materialDesign:Snackbar  Margin="0,0,0,8" Grid.ColumnSpan="2" VerticalAlignment="Top" MessageQueue="{Binding MessageQueue}" HorizontalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="{Binding MessageBackground}" Foreground="{DynamicResource MaterialDesignLightForeground}">
        </materialDesign:Snackbar>-->

        <Grid Grid.Row="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="auto"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="{language:L TestItemName}"></TextBlock>
                    <TextBox Margin="6,0,0,0" Grid.Column="1" Text="{Binding TestItem.TestItemName,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}"></TextBox>

                    <TextBlock Margin="0,18,0,0" VerticalAlignment="Center" Text="{language:L FunctionName}" Grid.Row="1"></TextBlock>
                    <TextBox Margin="6,18,0,0" Grid.Row="1" Grid.Column="1" Text="{Binding TestItem.FunctionName,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}"></TextBox>

                    <TextBlock Margin="0,18,0,0" VerticalAlignment="Center" Text="{language:L Force}" Grid.Row="2"></TextBlock>
                    <TextBox Margin="6,18,0,0" Grid.Row="2" Grid.Column="1" Text="{Binding TestItem.Force,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}"></TextBox>

                    <TextBlock VerticalAlignment="Center" Margin="0,18,0,0" Text="{language:L PinOrGroupName}" Grid.Row="3"></TextBlock>
                    <ComboBox ItemsSource="{Binding FilteredItems}" Grid.Row="3" Grid.Column="1" Margin="6,18,0,0" SelectedValue="{Binding TestItem.GroupOrPinId,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" DisplayMemberPath="Value" SelectedValuePath="Key" Style="{StaticResource MaterialDesignOutlinedComboBox}" Padding="4" Text="{Binding EditString,UpdateSourceTrigger=PropertyChanged}" IsEditable="True">
                    </ComboBox>

                    <TextBlock VerticalAlignment="Center" Margin="0,18,0,0" Text="{language:L LimitName}" Grid.Row="4"></TextBlock>
                    <ComboBox ItemsSource="{Binding LimitsDic}" Grid.Row="4" Grid.Column="1" Margin="6,18,0,0" SelectedValue="{Binding TestItem.LimitsId,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" DisplayMemberPath="Value" SelectedValuePath="Key" Style="{StaticResource MaterialDesignOutlinedComboBox}" Padding="4">
                    </ComboBox>

                    <TextBlock VerticalAlignment="Center" Margin="0,18,0,0" Text="{language:L LevelGroupName}" Grid.Row="5"></TextBlock>
                    <ComboBox ItemsSource="{Binding LevelGroupDic}" Grid.Row="5" Grid.Column="1" Margin="6,18,0,0" SelectedValue="{Binding TestItem.LevelGroupId}" DisplayMemberPath="Value" SelectedValuePath="Key" Style="{StaticResource MaterialDesignOutlinedComboBox}" Padding="4" materialDesign:TextFieldAssist.HasClearButton="True">
                    </ComboBox>

                    <TextBlock VerticalAlignment="Center" Margin="0,18,0,0" Text="{language:L TimingGroupName}" Grid.Row="6"></TextBlock>
                    <ComboBox ItemsSource="{Binding TimingGroupDic}" Grid.Row="6" Grid.Column="1" Margin="6,18,0,0" SelectedValue="{Binding TestItem.TimingGroupId}" DisplayMemberPath="Value" SelectedValuePath="Key" Style="{StaticResource MaterialDesignOutlinedComboBox}" Padding="4" materialDesign:TextFieldAssist.HasClearButton="True">
                    </ComboBox>

                </Grid>

                <GroupBox Margin="0,6" Grid.Row="1" Style="{StaticResource MaterialDesignCardGroupBox}" Header="{language:L AdditionalParameters}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Command="{Binding AddCommand}">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center"/>
                                    <TextBlock Text="{language:L AddAdditionalParameters}"></TextBlock>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <DataGrid Margin="0,6,0,0" 
                                  Grid.Row="1"
                                  Grid.ColumnSpan="2"
                                  VerticalContentAlignment="Center"
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False" 
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" 
                                  materialDesign:DataGridAssist.CellPadding="4"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.IsContainerVirtualizable="True"
                                  CanUserReorderColumns="False"
                                  ItemsSource="{Binding ParameterList}">
                            <DataGrid.Columns>
                                <DataGridTextColumn 
                                    Binding="{Binding Parameter,UpdateSourceTrigger=PropertyChanged}" 
                                    Width="*" 
                                    EditingElementStyle="{StaticResource CellEditTextBox}"
                                    ElementStyle="{StaticResource CellTextBlock}"></DataGridTextColumn>
                                <DataGridTemplateColumn Width="*" Header="{language:L Operate}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto"></ColumnDefinition>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}" Content="{language:L Delete}" Command="{Binding DataContext.DeleteCommand,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}" CommandParameter="{Binding }" Foreground="Red"></Button>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>

        <Grid Margin="0,8,0,0" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Margin="0,0,6,0" Content="{language:L OK}" Command="{Binding OKCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"></Button>

            <Button Grid.Column="2" Content="{language:L Cancel}" Style="{StaticResource MaterialDesignPaperButton}" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"></Button>
        </Grid>
    </Grid>
</UserControl>
