<UserControl x:Class="KSW.ATE01.Start.Views.Dialogs.TestPlans.AddLimitDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KSW.ATE01.Start.Views.Dialogs.TestPlans"
             xmlns:viewmodel="clr-namespace:KSW.ATE01.Start.ViewModels.Dialogs.TestPlans"
             xmlns:language="clr-namespace:KSW.ATE01.Start"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             mc:Ignorable="d" 
             d:Background="White"
             d:DataContext="{d:DesignInstance viewmodel:AddLimitDialogViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignTextBlock}">
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Padding" Value="4"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
        </Style>
    </UserControl.Resources>

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="ToolWindow"></Setter>
            <Setter Property="Height" Value="550"></Setter>
            <Setter Property="Width" Value="300"></Setter>
            <Setter Property="ResizeMode" Value="NoResize"></Setter>
            <Setter Property="ShowInTaskbar" Value="False"></Setter>
        </Style>
    </prism:Dialog.WindowStyle>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!--<materialDesign:Snackbar Padding="4" Grid.ColumnSpan="2" VerticalAlignment="Top" MessageQueue="{Binding MessageQueue}" HorizontalAlignment="Center" Background="{Binding MessageBackground}" Foreground="{DynamicResource MaterialDesignLightForeground}">
        </materialDesign:Snackbar>-->

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{language:L LimitName}"></TextBlock>
            <TextBox Text="{Binding Limit.LimitName,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" Grid.Column="1" Margin="6,0,0,0"></TextBox>

            <TextBlock Margin="0,18,0,0" Grid.Row="1" Text="{language:L TestNumber}"></TextBlock>
            <TextBox Text="{Binding Limit.TestNumber,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" Grid.Row="1" Grid.Column="1" Margin="6,18,0,0"></TextBox>

            <TextBlock Margin="0,18,0,0" Grid.Row="2" Text="{language:L LowLimit}"></TextBlock>
            <TextBox Text="{Binding Limit.LowLimit,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" Grid.Row="2" Grid.Column="1" Margin="6,18,0,0"></TextBox>

            <TextBlock Margin="0,18,0,0" Grid.Row="3" Text="{language:L HighLimit}"></TextBlock>
            <TextBox Text="{Binding Limit.HighLimit,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" Grid.Row="3" Grid.Column="1" Margin="6,18,0,0"></TextBox>

            <TextBlock Margin="0,18,0,0" Grid.Row="4" Text="{language:L Units}"></TextBlock>
            <TextBox Text="{Binding Limit.Units,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" Grid.Row="4" Grid.Column="1" Margin="6,18,0,0"></TextBox>

            <TextBlock Margin="0,18,0,0" Grid.Row="5" Text="{language:L FailSoftwareBin}"></TextBlock>
            <TextBox Text="{Binding Limit.FailSoftwareBin,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" Grid.Row="5" Grid.Column="1" Margin="6,18,0,0"></TextBox>

            <TextBlock Margin="0,18,0,0" Grid.Row="6" Text="{language:L PassSoftwareBin}"></TextBlock>
            <TextBox Text="{Binding Limit.PassSoftwareBin}" Grid.Row="6" Grid.Column="1" Margin="6,18,0,0"></TextBox>

            <TextBlock Margin="0,18,0,0" Grid.Row="7" Text="{language:L FailHardwareBin}"></TextBlock>
            <TextBox Text="{Binding Limit.FailHardwareBin,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" Grid.Row="7" Grid.Column="1" Margin="6,18,0,0"></TextBox>

            <TextBlock Margin="0,18,0,0" Grid.Row="8" Text="{language:L PassHardwareBin}"></TextBlock>
            <TextBox Text="{Binding Limit.PassHardwareBin}" Grid.Row="8" Grid.Column="1" Margin="6,18,0,0"></TextBox>

            <TextBlock Margin="0,18,0,0" Grid.Row="9" Text="{language:L DutResult}"></TextBlock>
            <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}" Padding="4" Grid.Row="9" Grid.Column="1" Margin="6,18,0,0" ItemsSource="{Binding DutResultDic}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Limit.DutResult,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}"></ComboBox>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Margin="0,0,6,0" Content="{language:L OK}" Command="{Binding OKCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"></Button>

            <Button Grid.Column="2" Content="{language:L Cancel}" Style="{StaticResource MaterialDesignPaperButton}" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"></Button>
        </Grid>
    </Grid>
</UserControl>
