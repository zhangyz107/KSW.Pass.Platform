<UserControl x:Class="KSW.ATE01.Start.Views.Dialogs.TestPlans.AddTimingDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KSW.ATE01.Start.Views.Dialogs.TestPlans"
             xmlns:viewmodel="clr-namespace:KSW.ATE01.Start.ViewModels.Dialogs.TestPlans"
             xmlns:language="clr-namespace:KSW.ATE01.Start"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance viewmodel:AddTimingDialogViewModel}"
             d:Background="White"
             d:DesignHeight="450" d:DesignWidth="800">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadingCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignTextBlock}">
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Padding" Value="4"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
        </Style>
    </UserControl.Resources>

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="ToolWindow"></Setter>
            <Setter Property="Height" Value="500"></Setter>
            <Setter Property="Width" Value="350"></Setter>
            <Setter Property="ResizeMode" Value="NoResize"></Setter>
            <Setter Property="ShowInTaskbar" Value="False"></Setter>
        </Style>
    </prism:Dialog.WindowStyle>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <materialDesign:Snackbar Padding="4" Grid.ColumnSpan="2" VerticalAlignment="Top" MessageQueue="{Binding MessageQueue}" HorizontalAlignment="Center" Background="{Binding MessageBackground}" Foreground="{DynamicResource MaterialDesignLightForeground}">
        </materialDesign:Snackbar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <TextBlock Margin="0,6,0,0" Grid.Row="1" Text="{language:L TimingName}"></TextBlock>
                <TextBox Text="{Binding Timing.TimingName}" Grid.Row="1" Grid.Column="1" Margin="6,6,0,0"></TextBox>

                <TextBlock Text="{language:L PinOrGroupName}"></TextBlock>
                <ComboBox ItemsSource="{Binding FilteredItems}" Grid.Column="1" Margin="6,0,0,0" SelectedValue="{Binding Timing.GroupOrPinId}" DisplayMemberPath="Value" SelectedValuePath="Key" Style="{StaticResource MaterialDesignOutlinedComboBox}" Padding="4" Text="{Binding EditString,UpdateSourceTrigger=PropertyChanged}" IsEditable="True">
                </ComboBox>

                <TextBlock Margin="0,6,0,0" Grid.Row="2" Text="{language:L Period}"></TextBlock>
                <TextBox Text="{Binding Timing.Period}" Grid.Row="2" Grid.Column="1" Margin="6,6,0,0"></TextBox>

                <TextBlock Margin="0,6,0,0" Grid.Row="3" Text="{language:L WaveformFormat}"></TextBlock>
                <ComboBox Grid.Row="3" Grid.Column="1" Margin="6,6,0,0" ItemsSource="{Binding TimingformatDic}" DisplayMemberPath="Value" SelectedValuePath="Key" Style="{StaticResource MaterialDesignOutlinedComboBox}" SelectedValue="{Binding Timing.WaveformFormat}" Padding="4"></ComboBox>

                <TextBlock Margin="0,6,0,0" Grid.Row="4" Text="DriveA"></TextBlock>
                <TextBox Text="{Binding Timing.DriveA}" Grid.Row="4" Grid.Column="1" Margin="6,6,0,0"></TextBox>

                <TextBlock Margin="0,6,0,0" Grid.Row="5" Text="DriveB"></TextBlock>
                <TextBox Text="{Binding Timing.DriveB}" Grid.Row="5" Grid.Column="1" Margin="6,6,0,0"></TextBox>

                <TextBlock Margin="0,6,0,0" Grid.Row="6" Text="DriveC"></TextBlock>
                <TextBox Text="{Binding Timing.DriveC}" Grid.Row="6" Grid.Column="1" Margin="6,6,0,0"></TextBox>

                <TextBlock Margin="0,6,0,0" Grid.Row="7" Text="DriveD"></TextBlock>
                <TextBox Text="{Binding Timing.DriveD}" Grid.Row="7" Grid.Column="1" Margin="6,6,0,0"></TextBox>

                <TextBlock Margin="0,6,0,0" Grid.Row="8" Text="StrobeMode"></TextBlock>
                <ComboBox Grid.Row="8" Grid.Column="1" Margin="6,6,0,0" ItemsSource="{Binding StrobeModeDic}" DisplayMemberPath="Value" SelectedValuePath="Key" Style="{StaticResource MaterialDesignOutlinedComboBox}" SelectedValue="{Binding Timing.StrobeMode}" Padding="4"></ComboBox>

                <TextBlock Margin="0,6,0,0" Grid.Row="9" Text="StrobeA"></TextBlock>
                <TextBox Text="{Binding Timing.StrobeA}" Grid.Row="9" Grid.Column="1" Margin="6,6,0,0"></TextBox>

                <TextBlock Margin="0,6,0,0" Grid.Row="10" Text="StrobeB"></TextBlock>
                <TextBox Text="{Binding Timing.StrobeB}" Grid.Row="10" Grid.Column="1" Margin="6,6,0,0"></TextBox>

                <TextBlock Margin="0,6,0,0" Grid.Row="11" Text="{language:L Comment}"></TextBlock>
                <TextBox Text="{Binding Timing.Comment}" Grid.Row="11" Grid.Column="1" Margin="6,6,0,0"></TextBox>
            </Grid>
        </ScrollViewer>

        <Grid Margin="0,8,0,0" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Margin="0,0,6,0" Content="{language:L OK}" Command="{Binding OKCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"></Button>

            <Button Grid.Column="2" Content="{language:L Cancel}" Style="{StaticResource MaterialDesignPaperButton}" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"></Button>
        </Grid>
    </Grid>
</UserControl>
