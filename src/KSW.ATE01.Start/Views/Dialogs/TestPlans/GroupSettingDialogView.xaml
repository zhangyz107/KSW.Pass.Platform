<UserControl x:Class="KSW.ATE01.Start.Views.Dialogs.TestPlans.GroupSettingDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KSW.ATE01.Start.Views.Dialogs.TestPlans"
             xmlns:language="clr-namespace:KSW.ATE01.Start"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodel="clr-namespace:KSW.ATE01.Start.ViewModels.Dialogs.TestPlans"
             xmlns:prism="http://prismlibrary.com/"
             d:DataContext="{d:DesignInstance viewmodel:GroupSettingDialogViewModel}"
             d:Background="White"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Visibility" Value="Collapsed"></Setter>
        </Style>
        <Style x:Key="CellTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
            <Setter Property="HorizontalAlignment" Value="Left"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
        </Style>
        <Style x:Key="CellEditTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}">
            <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
        </Style>
        <Style x:Key="CellComboBox" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignDataGridComboBox}">
            <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
        </Style>
    </UserControl.Resources>

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="ToolWindow"></Setter>
            <Setter Property="Height" Value="600"></Setter>
            <Setter Property="Width" Value="800"></Setter>
            <Setter Property="ResizeMode" Value="NoResize"></Setter>
            <Setter Property="ShowInTaskbar" Value="False"></Setter>
        </Style>
    </prism:Dialog.WindowStyle>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding AddGroupNameCommand}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Add" />
                        <TextBlock Text="{language:L AddGroupName}" />
                    </StackPanel>
                </Button.Content>
            </Button>

            <GroupBox Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,6,6" Header="{language:L GroupName}" Style="{StaticResource MaterialDesignCardGroupBox}">
                <DataGrid VerticalContentAlignment="Center"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                          materialDesign:DataGridAssist.CellPadding="4"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.IsContainerVirtualizable="True"
                          CanUserReorderColumns="False"
                          ItemsSource="{Binding GroupInfoList}"
                          SelectedValue="{Binding GroupInfo}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding SortId}" IsReadOnly="True" ElementStyle="{StaticResource CellTextBlock}"></DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding GroupName,UpdateSourceTrigger=LostFocus}"
                                            Width="*" 
                                            ElementStyle="{StaticResource CellTextBlock}"
                                            EditingElementStyle="{StaticResource CellEditTextBox}"/>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"></ColumnDefinition>
                                            <ColumnDefinition Width="auto"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource MaterialDesignFlatButton}" Content="{language:L OK}" Command="{Binding DataContext.SureGroupNameCommand,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}" CommandParameter="{Binding }"></Button>

                                        <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}" Content="{language:L Delete}" Command="{Binding DataContext.DeleteGroupNameCommand,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}" CommandParameter="{Binding }" Foreground="Red"></Button>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Button Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding AddPinNameCommand}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Add" />
                        <TextBlock Text="{language:L AddPin}" />
                    </StackPanel>
                </Button.Content>
            </Button>

            <GroupBox Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6" Header="{language:L PinName}" Style="{StaticResource MaterialDesignCardGroupBox}">
                <DataGrid VerticalContentAlignment="Center"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                          materialDesign:DataGridAssist.CellPadding="4"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.IsContainerVirtualizable="True"
                          CanUserReorderColumns="False"
                          ItemsSource="{Binding RelationshipList}"
                          SelectedValue="{Binding SelectRelationship}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding SortId}" IsReadOnly="True" ElementStyle="{StaticResource CellTextBlock}"></DataGridTextColumn>
                        <materialDesign:DataGridComboBoxColumn ItemsSourceBinding="{Binding Path=DataContext.PinInfoSelectList,RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}}" Width="*" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValueBinding="{Binding PinInfoId,UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource CellComboBox}"
                          ElementStyle="{StaticResource CellComboBox}"
                          ></materialDesign:DataGridComboBoxColumn>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"></ColumnDefinition>
                                            <ColumnDefinition Width="auto"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource MaterialDesignFlatButton}" Content="{language:L OK}" Command="{Binding DataContext.SurePinNameCommand,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}" CommandParameter="{Binding }"></Button>

                                        <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}" Content="{language:L Delete}" Command="{Binding DataContext.DeletePinNameCommand,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}" CommandParameter="{Binding }" Foreground="Red"></Button>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="1" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Margin="0,6,0,0" Content="{language:L OK}" Command="{Binding OKCommand}"></Button>
            <Button Grid.Column="2" Margin="6,6,0,0" Content="{language:L Cancel}"  Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding CnacelCommand}"></Button>

        </Grid>
    </Grid>
</UserControl>
