<UserControl x:Class="KSW.ATE01.Start.Views.Dialogs.ConfigureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KSW.ATE01.Start.Views.Dialogs"
        xmlns:language="clr-namespace:KSW.ATE01.Start"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        prism:ViewModelLocator.AutoWireViewModel="True">

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="ToolWindow"></Setter>
            <Setter Property="Height" Value="600"></Setter>
            <Setter Property="Width" Value="800"></Setter>
            <Setter Property="ResizeMode" Value="NoResize"></Setter>
            <Setter Property="ShowInTaskbar" Value="False"></Setter>
        </Style>
    </prism:Dialog.WindowStyle>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Border Margin="0,0,0,6" BorderThickness="1" BorderBrush="Gray" CornerRadius="2.5">
            <TabControl  HorizontalContentAlignment="Left" Style="{StaticResource MaterialDesignFilledTabControl}">
                <TabItem Header="{language:L LogFile}">
                    <Grid  Margin="4,8" TextElement.FontSize="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <!--<TextBlock Margin="0,0,6,6" VerticalAlignment="Center" Text="{language:L FileEncoding}"></TextBlock>
                        <ComboBox Margin="0,0,0,6" Padding="4" Grid.Column="1" ItemsSource="{Binding EncodingDic}" SelectedValue="{Binding ConfigureFileModel.FileEncoding}" Style="{StaticResource MaterialDesignOutlinedComboBox}"></ComboBox>-->

                        <TextBlock Margin="0,0,6,6" VerticalAlignment="Center" Text="{language:L FileReopenCheckInterval}"></TextBlock>
                        <TextBox Grid.Column="1" Margin="0,0,0,6" Padding="4" VerticalAlignment="Center" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding ConfigureFileModel.FileReopenInterval}" materialDesign:TextFieldAssist.SuffixText="secs"></TextBox>

                        <TextBlock Grid.Row="1" Margin="0,0,6,6" VerticalAlignment="Center" Text="{language:L FileChangeCheckInterval}"></TextBlock>
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" Padding="4" VerticalAlignment="Center" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding ConfigureFileModel.FileChangeInterval}" materialDesign:TextFieldAssist.SuffixText="msecs"></TextBox>
                    </Grid>
                </TabItem>

                <TabItem Header="{language:L KeywordHighlight}">
                    <materialDesign:DrawerHost x:Name="drawerHost" IsRightDrawerOpen="{Binding IsDrawerOpen}">
                        <materialDesign:DrawerHost.RightDrawerContent>
                            <Grid Width="300">
                                <colorpicker:StandardColorPicker Style="{StaticResource DefaultColorPickerStyle}" SelectedColor="{Binding SelectedKeyword.Foreground,Mode=TwoWay}">
                                </colorpicker:StandardColorPicker>
                            </Grid>
                        </materialDesign:DrawerHost.RightDrawerContent>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding AddCommand}">
                                    <Button.Content>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto"></ColumnDefinition>
                                                <ColumnDefinition Width="auto"></ColumnDefinition>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="Plus" />
                                            <TextBlock Grid.Column="1" Text="{language:L Add}" ></TextBlock>
                                        </Grid>
                                    </Button.Content>
                                </Button>
                            </Grid>
                            <DataGrid Grid.Row="1"  materialDesign:DataGridAssist.CellPadding="4" materialDesign:DataGridAssist.ColumnHeaderPadding="4"  AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="All" VerticalScrollBarVisibility="Auto" SelectionUnit="Cell" SelectionMode="Single" CanUserSortColumns="False"  CanUserResizeRows="False" ItemsSource="{Binding KeywordList}">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{language:L Index}" IsReadOnly="True" Binding="{Binding SortId}">
                                        <DataGridTextColumn.CellStyle>
                                            <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
                                                <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
                                            </Style>
                                        </DataGridTextColumn.CellStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Width="1.5*" Header="{language:L Keyword}" Binding="{Binding Keyword}"></DataGridTextColumn>
                                    <DataGridTemplateColumn  Width="*" Header="{language:L TextColor}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding ForegroundString}" Command="{Binding DataContext.SetForegroundCommand,RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}}"  CommandParameter="{Binding }" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{Binding ForegroundBrush}">
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridCheckBoxColumn  Width="*" Header="{language:L AlertHighlight}" Binding="{Binding IsHighlight}"></DataGridCheckBoxColumn>
                                    <DataGridTemplateColumn Width="0.5*" Header="{language:L Operate}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="{language:L Delete}" Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding DataContext.DeleteCommand,RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}}" CommandParameter="{Binding }"></Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                        </Grid>
                    </materialDesign:DrawerHost>
                </TabItem>
            </TabControl>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button Content="{language:L SaveConfigure}" Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding SaveCommand}"></Button>

            <Button Margin="0,0,6,0" Grid.Column="2" Content="{language:L OK}" Command="{Binding OKCommand}"></Button>
            <Button Grid.Column="3" Content="{language:L Cancel}" Style="{StaticResource MaterialDesignOutlinedButton}"  Command="{Binding CancelCommand}"></Button>
        </Grid>
    </Grid>
</UserControl>
