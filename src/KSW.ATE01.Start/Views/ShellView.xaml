<Window x:Class="KSW.ATE01.Start.Views.ShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KSW.ATE01.Start.Views"
        xmlns:language="clr-namespace:KSW.ATE01.Start"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodel="clr-namespace:KSW.ATE01.Start.ViewModels"
        mc:Ignorable="d"
        d:Background="White"
        d:DataContext="{d:DesignInstance viewmodel:ShellViewModel}"
        Title="{Binding Title}"
        WindowState="Maximized"
        prism:ViewModelLocator.AutoWireViewModel="True">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadingCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <materialDesign:ColorZone Padding="4" Mode="PrimaryMid">
            <Menu Style="{StaticResource MaterialDesignMenu}" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}">
                <MenuItem Header="{language:L Project}">
                    <MenuItem Header="{language:L NewProject}" Foreground="{DynamicResource MaterialDesignLightForeground}" Command="{Binding NewProjectCommand}">
                    </MenuItem>
                    <MenuItem Header="{language:L SaveAs}" Foreground="{DynamicResource MaterialDesignLightForeground}" Command="{Binding SaveAsCommand}">
                    </MenuItem>
                    <MenuItem Header="{language:L Release}" Foreground="{DynamicResource MaterialDesignLightForeground}" Command="{Binding ReleaseCommand}">
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="{language:L Help}">
                    <MenuItem Header="{language:L Language}" Foreground="{DynamicResource MaterialDesignLightForeground}">
                        <MenuItem Header="简体中文" IsCheckable="True" IsChecked="{Binding IsChinese}"></MenuItem>
                        <MenuItem Header="English" IsCheckable="True" IsChecked="{Binding IsChinese,Converter={StaticResource InvertBooleanConverter}}"></MenuItem>
                    </MenuItem>
                    <MenuItem Header="{language:L AboutUs}" Foreground="{DynamicResource MaterialDesignLightForeground}">
                    </MenuItem>
                </MenuItem>
            </Menu>
        </materialDesign:ColorZone>

        <ContentControl Margin="0,8" Grid.Row="1" prism:RegionManager.RegionName="{x:Static viewmodel:RegionNameManagement.ProjectViewContent}"></ContentControl>
    </Grid>

</Window>
