<UserControl x:Class="KSW.ATE01.Start.Views.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KSW.ATE01.Start.Views"
             xmlns:language="clr-namespace:KSW.ATE01.Start"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodel="clr-namespace:KSW.ATE01.Start.ViewModels"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadingCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <UserControl.Resources>
        <Style x:Key="CenterTextBlock"  TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
        </Style>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
        </Style>
        <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
            <Setter Property="Header" Value="{Binding DataContext.Title,UpdateSourceTrigger=PropertyChanged}" />
        </Style>
    </UserControl.Resources>


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="6"></ColumnDefinition>
            <ColumnDefinition Width="5*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <GroupBox Header="{language:L ProjectManagement}" Style="{StaticResource MaterialDesignCardGroupBox}">
            <DataGrid ItemsSource="{Binding ProjectList}" AutoGenerateColumns="False" CanUserAddRows="False" ScrollViewer.HorizontalScrollBarVisibility="Visible" materialDesign:DataGridAssist.CellPadding="2" Background="{DynamicResource MaterialDesignLightSeparatorBackground}" SelectedValue="{Binding SelectProjectInfo}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{language:L ProjectName}" Binding="{Binding ProjectName}" ElementStyle="{StaticResource CenterTextBlock}" IsReadOnly="True"></DataGridTextColumn>
                    <DataGridTemplateColumn Header="{language:L Operate}" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="{language:L Edit}" Style="{StaticResource MaterialDesignFlatButton}" Padding="8,4"></Button>
                                    <Button Grid.Column="1" Content="{language:L Develop}" Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding DelelopCommand}" Padding="8,4"></Button>
                                    <Button Grid.Column="2" Content="{language:L Run}" Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding RunCommand}" Padding="8,4"></Button>
                                    <Button Grid.Column="3" Content="{language:L Delete}" Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding RunCommand}" Padding="8,4" Foreground="Red"></Button>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        <GridSplitter  Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"></GridSplitter>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="4*"></RowDefinition>
                <RowDefinition Height="6"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <GroupBox Header="{language:L TestPlan}" Style="{StaticResource MaterialDesignCardGroupBox}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="auto"></ColumnDefinition>
                            <ColumnDefinition Width="auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSaveEditOutline" VerticalAlignment="Center"/>
                                    <TextBlock Text="{language:L SaveTestPlan}" VerticalAlignment="Center"></TextBlock>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button Margin="0,0,6,0" Grid.Column="2" Style="{StaticResource MaterialDesignOutlinedButton}">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Import" VerticalAlignment="Center"/>
                                    <TextBlock Text="导入数据" />
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </Grid>
                    <TabControl Grid.Row="1" Margin="0,8,0,0" prism:RegionManager.RegionName="{x:Static viewmodel:RegionNameManagement.TestPlanContent}" TabStripPlacement="Left" Style="{StaticResource MaterialDesignFilledTabControl}"></TabControl>
                </Grid>
            </GroupBox>
            <GridSplitter  Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"></GridSplitter>
            <GroupBox Grid.Row="2" Header="{language:L ProjectDetail}" Style="{StaticResource MaterialDesignCardGroupBox}">

            </GroupBox>
        </Grid>
        <!--<Border Margin="3" BorderThickness="1.5" BorderBrush="#2196fd" Padding="3" CornerRadius="2.5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                </Grid.RowDefinitions>
                <Button Margin="0,0,0,4" Content="{language:L NewProject}" Command="{Binding NewProjectCommand}"></Button>
                <Button Margin="0,0,0,4" Grid.Row="1" Content="{language:L OpenProject}" Command="{Binding OpenProjectCommand}"></Button>
                <Button Margin="0,0,0,4" Grid.Row="2" Content="{language:L SaveAs}" Command="{Binding SaveAsCommand}"></Button>
                <Button Margin="0,0,0,4" Grid.Row="3" Content="{language:L Develop}" Command="{Binding DelelopCommand}"></Button>
                <Button Margin="0,0,0,4" Grid.Row="4" Content="{language:L Run}" Command="{Binding RunCommand}"></Button>
                <Button Margin="0,0,0,4" Grid.Row="5" Content="{language:L Release}" Command="{Binding ReleaseCommand}"></Button>
            </Grid>
        </Border>

        <ContentControl Margin="3,3,6,3" Grid.Column="1" Content="{Binding ProjectDetailView,Mode=OneWay}"></ContentControl>-->
    </Grid>
</UserControl>
