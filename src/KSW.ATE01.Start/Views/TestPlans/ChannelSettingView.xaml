<UserControl x:Class="KSW.ATE01.Start.Views.TestPlans.ChannelSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KSW.ATE01.Start.Views.TestPlans"
             xmlns:language="clr-namespace:KSW.ATE01.Start"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:model="clr-namespace:KSW.ATE01.Start.ViewModels"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:Background="White"
             d:DesignHeight="450" d:DesignWidth="800"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadingCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <UserControl.Resources>
        <Style x:Key="CellTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
            <Setter Property="ToolTip" Value="{Binding Path=Text, RelativeSource={RelativeSource Mode=Self}}"></Setter>
        </Style>
    </UserControl.Resources>

    <materialDesign:DrawerHost x:Name="DrawerHost">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="站点数："></TextBlock>
                <ComboBox Grid.Column="1" Padding="4" Style="{StaticResource MaterialDesignOutlinedComboBox}" ItemsSource="{Binding SiteCountList}" SelectedValue="{Binding PinOverview.SiteCount}" IsEnabled="{Binding CanEdit}"></ComboBox>
                <Button Margin="6,0,0,0" Grid.Column="3" Command="{Binding SureSiteCountCommand}" Content="{language:L ComfirmSiteCount}">
                </Button>

                <Button Margin="0,6,0,0" Grid.Row="1" Padding="12,0" Command="{Binding AddPinCommand}" Style="{StaticResource MaterialDesignOutlinedButton}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center"/>
                            <TextBlock Text="{language:L AddPin}" />
                        </StackPanel>
                    </Button.Content>
                </Button>

                <Button Margin="6,6,0,0" Grid.Row="1" Grid.Column="1" Padding="12,0" Command="{Binding RemovePinCommand}" Style="{StaticResource MaterialDesignOutlinedButton}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Minus" VerticalAlignment="Center"/>
                            <TextBlock Text="{language:L DeletePin}" />
                        </StackPanel>
                    </Button.Content>
                </Button>

                <Button Margin="6,6,0,0" Grid.Row="1" Grid.Column="3" Padding="12,0" Command="{Binding GroupSettingCommand}" Style="{StaticResource MaterialDesignOutlinedButton}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FormatListGroupPlus" VerticalAlignment="Center"/>
                            <TextBlock Text="{language:L GroupSetting}" />
                        </StackPanel>
                    </Button.Content>
                </Button>
            </Grid>
            <DataGrid 
                Grid.Row="1" 
                Margin="6,0"
                ItemsSource="{Binding PinList}"
                AutoGenerateColumns="False" 
                CanUserAddRows="False" 
                ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                materialDesign:DataGridAssist.CellPadding="6"
                VirtualizingPanel.VirtualizationMode="Recycling"
                VirtualizingPanel.IsContainerVirtualizable="True"
                CanUserReorderColumns="False"
                SelectedValue="{Binding PinInfo}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{language:L Index}" IsReadOnly="True" Binding="{Binding SortId}" ElementStyle="{StaticResource CellTextBlock}"></DataGridTextColumn>
                    <DataGridTextColumn Header="{language:L PinName}" IsReadOnly="True" Binding="{Binding PinName}" ElementStyle="{StaticResource CellTextBlock}"></DataGridTextColumn>
                    <DataGridTextColumn Header="{language:L PinType}" IsReadOnly="True" Binding="{Binding PinTypeDescription}" ElementStyle="{StaticResource CellTextBlock}"></DataGridTextColumn>
                    <DataGridTemplateColumn Width="2*" Header="{language:L GroupName}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MaterialDesignFlatButton}" Content="{Binding GroupName}" Command="{Binding DataContext.PinGroupSettingCommand,RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}}" CommandParameter="{Binding }" ToolTip="{Binding GroupName}"></Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Width="2*" Header="{language:L ChannelName}" IsReadOnly="True" Binding="{Binding ChannelName}" ElementStyle="{StaticResource CellTextBlock}"></DataGridTextColumn>
                    <DataGridTemplateColumn Header="{language:L Operate}" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="{language:L Edit}" Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding DataContext.EditPinCommand,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}" CommandParameter="{Binding}"></Button>
                                    <Button Margin="6,0,0,0" Grid.Column="1" Content="{language:L DeletePin}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="Red" Command="{Binding DataContext.DeletePinCommand,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}" CommandParameter="{Binding}"></Button>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <materialDesign:DrawerHost.RightDrawerContent>
            <ContentControl prism:RegionManager.RegionName="{x:Static model:RegionNameManagement.GroupInfoContent}"></ContentControl>
        </materialDesign:DrawerHost.RightDrawerContent>
    </materialDesign:DrawerHost>
</UserControl>
