<UserControl x:Class="KSW.ATE01.Start.Views.TestPlans.TestItemSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KSW.ATE01.Start.Views.TestPlans"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:language="clr-namespace:KSW.ATE01.Start"
             xmlns:viewmodel ="clr-namespace:KSW.ATE01.Start.ViewModels.TestPlans"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance viewmodel:TestItemSettingViewModel}"
             d:Background="White"
             d:DesignHeight="450" d:DesignWidth="800"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadingCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <UserControl.Resources>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
        </Style>
        <Style x:Key="CellTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
        </Style>
        <Style x:Key="CellEditTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button Padding="12,0" Command="{Binding AddTestItemCommand}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" />
                        <TextBlock Text="{language:L AddTestItem}" />
                    </StackPanel>
                </Button.Content>
            </Button>

            <Button Margin="6,0,0,0" Grid.Column="1" Padding="12,0" Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding RemoveTestItemCommand}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Minus" VerticalAlignment="Center"/>
                        <TextBlock Text="{language:L DeleteTestItem}" />
                    </StackPanel>
                </Button.Content>
            </Button>
        </Grid>

        <Border Grid.Row="1" Margin="0,6,6,0" BorderThickness="1" BorderBrush="{DynamicResource MaterialDesign.Brush.Foreground}" CornerRadius="4">
            <DataGrid  AutoGenerateColumns="False" 
                       CanUserAddRows="False" 
                       ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                       materialDesign:DataGridAssist.CellPadding="4"
                       VirtualizingPanel.VirtualizationMode="Recycling"
                       VirtualizingPanel.IsContainerVirtualizable="True"
                       CanUserReorderColumns="False"
                       ItemsSource="{Binding TestItemList}"
                       SelectedValue="{Binding SelectTestItem}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding SortId}" 
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CellTextBlock}" 
                                        Header="{language:L Index}"></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding TestItemName}" 
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CellTextBlock}" 
                                        Header="{language:L TestItemName}"></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding FunctionName}" 
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CellTextBlock}" 
                                        Header="{language:L FunctionName}"></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Force}" 
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CellTextBlock}" 
                                        Header="{language:L Force}"></DataGridTextColumn>
                    <DataGridTextColumn Header="{language:L PinOrGroupName}" 
                                        Binding="{Binding PinOrGroupName}"
                                        IsReadOnly="True" 
                                        ElementStyle="{StaticResource CellTextBlock}"/>
                    <DataGridTextColumn Header="{language:L LimitName}" 
                                        Binding="{Binding LimitName}"
                                        IsReadOnly="True" 
                                        ElementStyle="{StaticResource CellTextBlock}"/>
                    <DataGridTextColumn Header="{language:L LevelGroupName}" 
                                        Binding="{Binding LevelGroupName}"
                                        IsReadOnly="True" 
                                        ElementStyle="{StaticResource CellTextBlock}"/>
                    <DataGridTextColumn Header="{language:L TimingGroupName}" 
                                        Binding="{Binding TimingGroupName}"
                                        IsReadOnly="True" 
                                        ElementStyle="{StaticResource CellTextBlock}"/>
                    <DataGridTextColumn Header="{language:L AdditionalParameters}" 
                                        Binding="{Binding AdditionInfo}"
                                        IsReadOnly="True" 
                                        ElementStyle="{StaticResource CellTextBlock}"
                                        ToolTipService.ToolTip="{Binding AdditionInfo}"
                                        Width="0.5*"/>
                    <DataGridTemplateColumn Width="*" Header="{language:L Operate}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Content="{language:L Edit}" Command="{Binding DataContext.EditTestItemCommand,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}" CommandParameter="{Binding }"></Button>

                                    <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}" Content="{language:L Delete}" Command="{Binding DataContext.DeleteTestItemCommand,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}" CommandParameter="{Binding }" Foreground="Red"></Button>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
