<UserControl x:Class="KSW.ATE01.Start.Views.TestPlans.LimitsSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KSW.ATE01.Start.Views.TestPlans"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:language="clr-namespace:KSW.ATE01.Start"
             xmlns:viewmodel ="clr-namespace:KSW.ATE01.Start.ViewModels.TestPlans"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance viewmodel:LimitsSettingViewModel}"
             d:Background="White"
             d:DesignHeight="450" d:DesignWidth="800"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
        </Style>
        <Style x:Key="CellTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
        </Style>
        <Style x:Key="CellEditTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button Padding="12,0" Command="{Binding AddLimitCommand}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" />
                        <TextBlock Text="{language:L AddLimit}" />
                    </StackPanel>
                </Button.Content>
            </Button>

            <Button Margin="6,0,0,0" Grid.Column="1" Padding="12,0" Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding RemoveLimitCommand}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Minus" VerticalAlignment="Center"/>
                        <TextBlock Text="{language:L DeleteLimit}" />
                    </StackPanel>
                </Button.Content>
            </Button>
        </Grid>

        <Border Grid.Row="1" Margin="0,6,6,0" BorderThickness="1" BorderBrush="{DynamicResource MaterialDesign.Brush.Foreground}" CornerRadius="4">
            <DataGrid  AutoGenerateColumns="False" 
                       CanUserAddRows="False" 
                       ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                       materialDesign:DataGridAssist.CellPadding="4"
                       VirtualizingPanel.VirtualizationMode="Recycling"
                       VirtualizingPanel.IsContainerVirtualizable="True"
                       CanUserReorderColumns="False"
                       ItemsSource="{Binding LimitList}"
                       SelectedValue="{Binding SelectLimit}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding SortId}" 
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CellTextBlock}" 
                                        EditingElementStyle="{StaticResource CellEditTextBox}"
                                        Header="{language:L Index}"></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding LimitName}" 
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CellTextBlock}" 
                                        EditingElementStyle="{StaticResource CellEditTextBox}"
                                        Header="{language:L LimitName}"></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding TestNumber}" 
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CellTextBlock}" 
                                        EditingElementStyle="{StaticResource CellEditTextBox}"
                                        Header="{language:L TestNumber}"></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding LowLimit}" 
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CellTextBlock}" 
                                        EditingElementStyle="{StaticResource CellEditTextBox}"
                                        Header="{language:L LowLimit}"></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding HighLimit}" 
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CellTextBlock}" 
                                        EditingElementStyle="{StaticResource CellEditTextBox}"
                                        Header="{language:L HighLimit}"></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Units}" 
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CellTextBlock}" 
                                        EditingElementStyle="{StaticResource CellEditTextBox}"
                                        Header="{language:L Units}"></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding FailSoftwareBin}" 
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CellTextBlock}" 
                                        EditingElementStyle="{StaticResource CellEditTextBox}"
                                        Header="{language:L FailSoftwareBin}"></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding PassSoftwareBin}" 
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CellTextBlock}" 
                                        EditingElementStyle="{StaticResource CellEditTextBox}"
                                        Header="{language:L PassSoftwareBin}"></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding FailHardwareBin}" 
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CellTextBlock}" 
                                        EditingElementStyle="{StaticResource CellEditTextBox}"
                                        Header="{language:L FailHardwareBin}"></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding PassHardwareBin}" 
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CellTextBlock}" 
                                        EditingElementStyle="{StaticResource CellEditTextBox}"
                                        Header="{language:L PassHardwareBin}"></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding DutResult}" 
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CellTextBlock}" 
                                        EditingElementStyle="{StaticResource CellEditTextBox}"
                                        Header="{language:L DutResult}"></DataGridTextColumn>
                    <DataGridTemplateColumn Width="*" Header="{language:L Operate}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Content="{language:L Edit}" Command="{Binding DataContext.EditLimitCommand,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}" CommandParameter="{Binding }"></Button>

                                    <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}" Content="{language:L Delete}" Command="{Binding DataContext.DeleteLimitCommand,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}" CommandParameter="{Binding }" Foreground="Red"></Button>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
