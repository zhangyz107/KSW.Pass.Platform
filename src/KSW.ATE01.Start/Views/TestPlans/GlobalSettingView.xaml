<UserControl x:Class="KSW.ATE01.Start.Views.TestPlans.GlobalSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KSW.ATE01.Start.Views.TestPlans"
             xmlns:viewmodel="clr-namespace:KSW.ATE01.Start.ViewModels.TestPlans"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:language="clr-namespace:KSW.ATE01.Start"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance viewmodel:GlobalSettingViewModel}"
             d:Background="White"
             d:DesignHeight="450" d:DesignWidth="800"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadingCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <UserControl.Resources>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
        </Style>
        <Style x:Key="CellTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
        </Style>
        <Style x:Key="CellEditTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button Command="{Binding AddGlobalParameterCommand}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center"/>
                        <TextBlock Text="{language:L AddGlobalParameters}"></TextBlock>
                    </StackPanel>
                </Button.Content>
            </Button>

            <Button Margin="6,0,0,0" Grid.Column="1" Padding="12,0" Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding RemoveGlobalParameterCommand}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Minus" VerticalAlignment="Center"/>
                        <TextBlock Text="{language:L DeleteGlobalParameters}" />
                    </StackPanel>
                </Button.Content>
            </Button>
        </Grid>
        <Border Grid.Row="1" Margin="0,6,6,0" BorderThickness="1" BorderBrush="{DynamicResource MaterialDesign.Brush.Foreground}" CornerRadius="4">
            <DataGrid AutoGenerateColumns="False" 
                      CanUserAddRows="False" 
                      ScrollViewer.HorizontalScrollBarVisibility="Visible" 
                      materialDesign:DataGridAssist.CellPadding="4"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.IsContainerVirtualizable="True"
                      CanUserReorderColumns="False"
                      ItemsSource="{Binding GlobalParameterList}"
                      SelectedValue="{Binding SelectGlobalParameter}">
                <DataGrid.Columns>
                    <DataGridTextColumn 
                        Binding="{Binding SortId}" 
                        Header="{language:L Index}" 
                        IsReadOnly="True"
                        ElementStyle="{StaticResource CellTextBlock}" ></DataGridTextColumn>
                    <DataGridTextColumn 
                        Binding="{Binding PatternFile}" 
                        Header="{language:L PatternFile}" 
                        IsReadOnly="True"
                        ElementStyle="{StaticResource CellTextBlock}" ></DataGridTextColumn>
                    <DataGridTextColumn
                        Binding="{Binding AdditionInfo}" 
                        Header="{language:L AdditionalParameters}" 
                        Width="*"
                        IsReadOnly="True"
                        ElementStyle="{StaticResource CellTextBlock}"
                        ToolTipService.ToolTip="{Binding AdditionInfo}"></DataGridTextColumn>
                    <DataGridTemplateColumn Header="{language:L Operate}" Width="0.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Content="{language:L Edit}" Command="{Binding DataContext.EditGlobalParameterCommand,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}" CommandParameter="{Binding }"></Button>

                                    <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}" Content="{language:L Delete}" Command="{Binding DataContext.DeleteGlobalParameterCommand,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}" CommandParameter="{Binding }" Foreground="Red"></Button>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
