<messageCard:MessageCard x:Class="KSW.UI.WPF.Controls.ToastCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KSW.UI.WPF.Controls"
             xmlns:messageCard="clr-namespace:KSW.UI.WPF.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:enums="clr-namespace:KSW.UI.WPF.Enums"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <messageCard:MessageCard.Resources>
        <DataTemplate x:Key="TemplateA" DataType="{x:Type local:Toast}">
            <TextBlock
                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                FontWeight="SemiBold"
                VerticalAlignment="Center"
                Text="{Binding Content}"
                TextWrapping="Wrap">
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="TemplateB" DataType="{x:Type sys:String}">
            <TextBlock
                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                FontWeight="SemiBold"
                Text="{Binding}"
                VerticalAlignment="Center"
                TextWrapping="Wrap">
            </TextBlock>
        </DataTemplate>
        <local:ToastDataTemplateSelector x:Key="TemplateSelector" 
                                         ToastTemplate="{StaticResource TemplateA}"
                                         StringTemplate="{StaticResource TemplateB}">
        </local:ToastDataTemplateSelector>

        <DataTemplate x:Key="ToastIconStyle" DataType="{x:Type enums:NotificationType}">
            <materialDesign:PackIcon x:Name="ToastIcon" Width="20" Height="20"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding }" Value="{x:Static enums:NotificationType.Information}">
                    <Setter TargetName="ToastIcon" Property="Kind" Value="Information"></Setter>
                    <Setter TargetName="ToastIcon" Property="Foreground" Value="{DynamicResource  KSW.Toast.Brush.Information}"></Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding }" Value="{x:Static enums:NotificationType.Success}">
                    <Setter TargetName="ToastIcon" Property="Kind" Value="CheckCircle"></Setter>
                    <Setter TargetName="ToastIcon" Property="Foreground" Value="{DynamicResource KSW.Toast.Brush.Success}"></Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding }" Value="{x:Static enums:NotificationType.Warning}">
                    <Setter TargetName="ToastIcon" Property="Kind" Value="Alert"></Setter>
                    <Setter TargetName="ToastIcon" Property="Foreground" Value="{DynamicResource KSW.Toast.Brush.Warning}"></Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding }" Value="{x:Static enums:NotificationType.Error}">
                    <Setter TargetName="ToastIcon" Property="Kind" Value="AlertCircle"></Setter>
                    <Setter TargetName="ToastIcon" Property="Foreground" Value="{DynamicResource KSW.Toast.Brush.Error}"></Setter>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="OutlineBorderStyle" TargetType="Border" >
            <Style.Triggers>
                <DataTrigger Binding="{Binding NotificationType}" Value="{x:Static enums:NotificationType.Information}">
                    <Setter Property="BorderBrush" Value="{DynamicResource  KSW.Toast.Brush.Information}"></Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding NotificationType}" Value="{x:Static enums:NotificationType.Success}">
                    <Setter Property="BorderBrush" Value="{DynamicResource KSW.Toast.Brush.Success}"></Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding NotificationType}" Value="{x:Static enums:NotificationType.Warning}">
                    <Setter Property="BorderBrush" Value="{DynamicResource KSW.Toast.Brush.Warning}"></Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding NotificationType}" Value="{x:Static enums:NotificationType.Error}">
                    <Setter Property="BorderBrush" Value="{DynamicResource KSW.Toast.Brush.Error}"></Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </messageCard:MessageCard.Resources>

    <ContentControl.Template>
        <ControlTemplate TargetType="{x:Type local:ToastCard}">
            <Border
                x:Name="PART_RootBorder"
                Background="{DynamicResource MaterialDesign.Brush.Background}"
                BorderThickness="2"
                CornerRadius="6"
                Padding="12 8"
                VerticalAlignment="Top"
                Style="{StaticResource OutlineBorderStyle}">
                <DockPanel>
                    <ContentControl 
                        x:Name="ToastIcon"
                        Margin="0 2 0 0"
                        Content="{Binding NotificationType}" 
                        ContentTemplate="{StaticResource ToastIconStyle}"></ContentControl>
                    <ContentControl
                        x:Name="PART_Content"
                        Margin="12 0"
                        VerticalContentAlignment="Center"
                        MaxWidth="{DynamicResource ToastCardContentMaxWidth}"
                        Content="{TemplateBinding Content}"
                        ContentTemplateSelector="{StaticResource TemplateSelector}">
                    </ContentControl>
                </DockPanel>
            </Border>
        </ControlTemplate>
    </ContentControl.Template>

</messageCard:MessageCard>
