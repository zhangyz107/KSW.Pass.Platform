<UserControl x:Class="KSW.ATE01.Extension.VS2022.UI.Views.Controls.CanvasTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KSW.ATE01.Extension.VS2022.UI.Views.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="#F0F0F0" BorderThickness="0" CornerRadius="8">
                            <TextBox Padding="1" Background="Transparent" BorderThickness="0" Text="{Binding Path= Text,RelativeSource={RelativeSource AncestorType=TextBox}}" HorizontalContentAlignment="{Binding Path=HorizontalContentAlignment,RelativeSource={RelativeSource AncestorType=TextBox}}"></TextBox>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="MinWidth" Value="62"></Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" Background="Transparent">
        <StackPanel.RenderTransform>
            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"></ScaleTransform>
        </StackPanel.RenderTransform>
        <TextBlock x:Name="labelTb" Margin="0,0,6,0" Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" Visibility="{Binding LabelVisiblity}"></TextBlock>
        <TextBox x:Name="contentTb" Margin="0,0,6,0"  Style="{StaticResource RoundedTextBox}" Text="{Binding Text}" FontSize="12" HorizontalContentAlignment="Center"></TextBox>
        <TextBlock x:Name="unitTb" Text="{Binding Units}" FontSize="12" VerticalAlignment="Center" Visibility="{Binding UnitsVisiblity}"></TextBlock>
    </StackPanel>
</UserControl>
