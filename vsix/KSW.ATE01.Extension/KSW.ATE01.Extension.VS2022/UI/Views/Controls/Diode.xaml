<UserControl x:Class="KSW.ATE01.Extension.VS2022.UI.Views.Controls.Diode"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KSW.ATE01.Extension.VS2022.UI.Views.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Canvas>
        <Line X1="0" Y1="0" X2="20" Y2="0" Stroke="Black" StrokeThickness="1" Canvas.Left="18" Canvas.Top="0" Panel.ZIndex="99">
            <Line.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1"></ScaleTransform>
                    <RotateTransform Angle="135" CenterX="10" CenterY="0"/>
                </TransformGroup>
            </Line.RenderTransform>
        </Line>

        <Path Fill="Black" StrokeThickness="1" Stroke="Black" Canvas.Left="14" Canvas.Top="-4" Panel.ZIndex="99">
            <Path.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="0.2" ScaleY="0.2"/>
                    <SkewTransform/>
                    <RotateTransform Angle="-135" CenterX="10" CenterY="0"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Path.RenderTransform>
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="0,-22">
                        <LineSegment Point="20,-22" />
                        <LineSegment Point="0,18" />
                        <LineSegment Point="40,18" />
                        <LineSegment Point="20,-22" />
                        <LineSegment Point="40,-22" />
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>

        <Line X1="0" Y1="0" X2="20" Y2="0" Stroke="Black" StrokeThickness="1" Canvas.Left="32" Canvas.Top="0" Panel.ZIndex="99">
            <Line.RenderTransform>
                <RotateTransform Angle="45" CenterX="10" CenterY="0"/>
            </Line.RenderTransform>
        </Line>

        <Path Fill="Black" StrokeThickness="1" Stroke="Black" Canvas.Left="28" Canvas.Top="4" Panel.ZIndex="99">
            <Path.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="0.2" ScaleY="0.2"/>
                    <SkewTransform/>
                    <RotateTransform Angle="135" CenterX="10" CenterY="0"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Path.RenderTransform>
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="0,-22">
                        <LineSegment Point="20,-22" />
                        <LineSegment Point="0,18" />
                        <LineSegment Point="40,18" />
                        <LineSegment Point="20,-22" />
                        <LineSegment Point="40,-22" />
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>

        <Line X1="0" Y1="0" X2="20" Y2="0" Stroke="Black" StrokeThickness="1" Canvas.Left="18" Canvas.Top="14" Panel.ZIndex="99">
            <Line.RenderTransform>
                <RotateTransform Angle="45" CenterX="10" CenterY="0"/>
            </Line.RenderTransform>
        </Line>

        <Path Fill="Black" StrokeThickness="1" Stroke="Black" Canvas.Left="14" Canvas.Top="18" Panel.ZIndex="99">
            <Path.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="0.2" ScaleY="0.2"/>
                    <SkewTransform/>
                    <RotateTransform Angle="135" CenterX="10" CenterY="0"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Path.RenderTransform>
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="0,-22">
                        <LineSegment Point="20,-22" />
                        <LineSegment Point="0,18" />
                        <LineSegment Point="40,18" />
                        <LineSegment Point="20,-22" />
                        <LineSegment Point="40,-22" />
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>

        <Line X1="0" Y1="0" X2="20" Y2="0" Stroke="Black" StrokeThickness="1" Canvas.Left="32" Canvas.Top="14" Panel.ZIndex="99">
            <Line.RenderTransform>
                <RotateTransform Angle="135" CenterX="10" CenterY="0"/>
            </Line.RenderTransform>
        </Line>

        <Path Fill="Black" StrokeThickness="1" Stroke="Black" Canvas.Left="28" Canvas.Top="10" Panel.ZIndex="99">
            <Path.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="0.2" ScaleY="0.2"/>
                    <SkewTransform/>
                    <RotateTransform Angle="-135" CenterX="10" CenterY="0"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Path.RenderTransform>
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="0,-22">
                        <LineSegment Point="20,-22" />
                        <LineSegment Point="0,18" />
                        <LineSegment Point="40,18" />
                        <LineSegment Point="20,-22" />
                        <LineSegment Point="40,-22" />
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>
    </Canvas>
</UserControl>
