<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>$(NetTargetFramework)</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Resource\Images\cross.png" />
	  <None Remove="Resource\Images\help.png" />
	  <None Remove="Resource\Images\reduce.png" />
	  <None Remove="Resource\Images\tick.png" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="DryIoc.Microsoft.DependencyInjection" Version="6.2.0" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
		<PackageReference Include="MaterialDesignThemes" Version="$(MaterialDesignVersion)" />
		<PackageReference Include="Prism.DryIoc" Version="$(PrismVersion)" />
		<PackageReference Include="Serilog" Version="4.0.1" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\..\src-platform\KSW.ObjectMapping.AutoMapper\KSW.ObjectMapping.AutoMapper.csproj" />
	  <ProjectReference Include="..\..\..\src-platform\KSW.UI.WPF\KSW.UI.WPF.csproj" />
	  <ProjectReference Include="..\KSW.ATE01.Pattern.Application.Events\KSW.ATE01.Pattern.Application.Events.csproj" />
	  <ProjectReference Include="..\KSW.ATE01.Pattern.Application\KSW.ATE01.Pattern.Application.csproj" />
	  <ProjectReference Include="..\KSW.ATE01.Pattern.Domain.Projects.Core\KSW.ATE01.Pattern.Domain.Projects.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Properties\Resources.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Resources.resx</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Properties\Resources.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>Resources.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
	  <Resource Include="Resource\Images\cross.png" />
	  <Resource Include="Resource\Images\help.png" />
	  <Resource Include="Resource\Images\reduce.png" />
	  <Resource Include="Resource\Images\tick.png" />
	</ItemGroup>

</Project>
