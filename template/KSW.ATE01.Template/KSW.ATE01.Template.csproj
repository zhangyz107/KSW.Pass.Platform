<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TestplanType>Test-Plan</TestplanType>
		<RootNamespace>CustomerProgram</RootNamespace>
	</PropertyGroup>

	<Choose>
		<When Condition="'$(TestplanType)'=='Csv'">
			<ItemGroup>
				<EmbeddedResource Include="TestPlan\*.csv" />
			</ItemGroup>
		</When>
	</Choose>

	<ItemGroup>
	  <Compile Remove="Release\**" />
	  <EmbeddedResource Remove="Release\**" />
	  <None Remove="Release\**" />
	</ItemGroup>

</Project>
